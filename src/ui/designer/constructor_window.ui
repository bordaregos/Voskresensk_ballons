         <widget class="QWidget" name="page_employees">
          <!-- Визуал по образцу docs/design/сотрудники_конструктор.html:
               слева узкий список-каталог сотрудников (карточки, не строки
               таблицы с шапкой), справа хлебная крошка и форма реквизитов
               без рамок групп-боксов, снизу общая панель действий
               Удалить/Сохранить, тот же принцип, что и у page_database
               рядом (сайдбар и основная область). Виджеты: ТОЧНО те же
               objectName, что и tab_employees в pipeline_window.ui
               (table_employees/employee_position/.../pushButt_saveEmployee),
               поэтому базовый EmployeesTabController по-прежнему заводится
               без единой строчки новой CRUD-логики, визуал карточек и
               хлебной крошки добавлен отдельным подклассом
               ConstructorEmployeesTabController (см. employees_tab.py),
               переопределяющим только отрисовку. -->
          <layout class="QHBoxLayout" name="pageEmployeesLayout">
